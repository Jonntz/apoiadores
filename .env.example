# Copy to .env.local for development. On Vercel, set the same keys under
# Settings → Environment Variables.

# --- Google Sheets (server-only, never exposed to the browser) --------------
# Service account address from the JSON key file.
GOOGLE_SA_EMAIL="lp-militancia@seu-projeto.iam.gserviceaccount.com"

# The "private_key" value from that same file, quoted, with its \n escapes left
# exactly as they are.
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# From the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEETS_SPREADSHEET_ID="1AbCdEf..."

# Tab that receives the rows. Defaults to "Apoiadores".
SHEETS_TAB_NAME="Apoiadores"

# --- Public ------------------------------------------------------------------
# Canonical origin, used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL="https://matheusbiancardine.com.br"

# WhatsApp group invite shown on the thank-you page. Falls back to a direct
# chat with the campaign line when unset.
NEXT_PUBLIC_WHATSAPP_GROUP_URL="https://chat.whatsapp.com/5531985931115"
